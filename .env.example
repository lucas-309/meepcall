# meepcall runs fully local with NO keys set — ⌘⇧R records anything,
# whisper.cpp transcribes on-device, everything stored in userData/.
# The two keys below are OPTIONAL ADD-ONS:

# Recall.ai (optional) — enables Zoom/Meet/Teams auto-detect with
# per-participant speaker labels. Sign up at recall.ai; new accounts
# get a few hours of free credits. Both URL and KEY must be set
# together — leave both blank to skip.
# Pick the URL for your workspace region:
#   US PAYG:    https://us-west-2.recall.ai
#   US Monthly: https://us-east-1.recall.ai
#   EU:         https://eu-central-1.recall.ai
#   JP:         https://ap-northeast-1.recall.ai
RECALLAI_API_URL=
RECALLAI_API_KEY=

# Anthropic (optional) — enables AI summaries on call end and live
# translation of non-English transcript lines via Haiku 4.5. Without it
# recordings save fine and transcripts are written to meetings.json;
# "Generate AI Summary" fails, and translation only works if you switch
# to the on-device NLLB engine (see MEEPCALL_TRANSLATE_ENGINE below).
ANTHROPIC_API_KEY=

# OpenAI (optional) — only needed if you switch transcribe and/or
# translate to the new gpt-realtime audio models below. The default
# free path (local whisper.cpp + NLLB) does NOT need this.
OPENAI_API_KEY=

# ─── Transcription engine ────────────────────────────────────────────
#
# Picks how live audio gets converted to source-language text.
#
#   local (default)   — whisper.cpp running in a resident whisper-server
#                       per source. Free, on-device, ships with the app.
#                       2 s fixed-window chunks; ~1-2 s end-to-end.
#   openai-realtime   — gpt-realtime-whisper over WebSocket
#                       (wss://api.openai.com/v1/realtime?intent=transcription).
#                       Server-side VAD picks phrase boundaries; phrase-
#                       aligned deltas come back at ~200-400 ms. Needs
#                       OPENAI_API_KEY. Pricing: ~$0.017 / minute of
#                       audio per stream — meepcall opens one stream per
#                       source (mic + system), so ~$0.034/min total.
#
# When this is `openai-realtime` AND MEEPCALL_TRANSLATE_ENGINE is also
# `openai-realtime`, meepcall uses ONE gpt-realtime-translate socket per
# source instead — that single model emits both source AND target text,
# so you don't pay for two parallel uploads of the same audio.
#
# MEEPCALL_TRANSCRIBE_ENGINE=openai-realtime
#
# Optional override (default: gpt-realtime-whisper):
# MEEPCALL_OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-realtime-whisper

# Optional: skip microphone capture entirely and transcribe only system
# audio. Useful when Mac speaker output is being picked up by both the
# mic and the system-audio stream. One-shot dev command:
#   DISABLE_MIC=1 pnpm dev
# DISABLE_MIC=1

# ─── Translation engine ──────────────────────────────────────────────
#
# Picks how non-English transcript lines get translated to English.
#
#   haiku (default)   — Anthropic Haiku 4.5. Best quality on noisy
#                       whisper output: ASR-error correction with
#                       phonetic homophone recovery, 10-line context
#                       window. ~1-2 s per line. Needs ANTHROPIC_API_KEY.
#   local             — NLLB-200-distilled-600M via Transformers.js.
#                       Free, on-device, no API key. Sub-second per
#                       line. No ASR correction — translates literal
#                       text, so noisy lines read worse than via Haiku.
#                       This is the right pick for fully-free meepcall.
#   openai-realtime   — gpt-realtime-translate over WebSocket
#                       (wss://api.openai.com/v1/realtime/translations).
#                       Streaming speech-to-text translation; phrase-
#                       aligned target text arrives within a few hundred
#                       ms of the source. Pricing: ~$0.034/minute per
#                       stream. Requires MEEPCALL_TRANSCRIBE_ENGINE=
#                       openai-realtime too — mixing with local
#                       transcribe would need timestamp-matching across
#                       independent streams and isn't supported.
#
# MEEPCALL_TRANSLATE_ENGINE=local
#
# Optional overrides:
# MEEPCALL_TRANSLATE_MODEL=claude-haiku-4-5-20251001  (haiku engine)
# MEEPCALL_OPENAI_REALTIME_TRANSLATE_MODEL=gpt-realtime-translate
# MEEPCALL_OPENAI_REALTIME_TARGET_LANG=en  (non-English target if you
#   actually want captions in some other language than English)

# Optional: route ad-hoc recordings (⌘⇧R, Record Audio button, comm-app
# banner) through the Recall Desktop SDK instead of the local whisper.cpp
# pipeline. Useful for A/B-testing Recall transcription quality. Costs
# Recall credits ($0.50/hr recording + $0.15/hr transcription) when on.
# Unset or set to 0 to use the free local pipeline.
# MEEPCALL_USE_RECALL_FOR_ADHOC=1

# Optional: run BOTH local whisper and Recall in parallel on the same
# recording (side-by-side comparison mode). Local writes to the meeting
# note as normal; Recall transcripts print to terminal only. Same Recall
# cost as USE_RECALL_FOR_ADHOC. Stop hits both engines.
# MEEPCALL_COMPARE_MODE=1

# Optional: per-run override for the recallai_streaming provider config.
# Defaults: lang=en, mode=prioritize_low_latency (English real-time).
# For multilingual auto-detect: lang=auto, mode=prioritize_accuracy
# (transcripts batch every 3-10 minutes — not real-time).
# MEEPCALL_RECALL_LANG=auto
# MEEPCALL_RECALL_MODE=prioritize_accuracy

# Cut whisper chunks at natural phrase boundaries detected by silero-vad
# (a 2 MB ONNX speech-detection model) instead of the default 3 s/2 s
# sliding window. Variable-size chunks (1-5 s) aligned to real speech
# pauses — better quality on conversational audio because phrases don't
# get cut mid-word. On continuous audio (music) it falls back to the 5 s
# max cap, comparable to the sliding window. Off by default.
# MEEPCALL_PHRASE_VAD=1

# Whisper diagnostics (local pipeline)
# Verbose log of every segment whisper produces and which filter dropped it.
# Useful for "where did my lyrics go?" debugging.
# MEEPCALL_DEBUG_WHISPER=1
#
# Bypass all post-whisper text filters (hallucination + dedup). Overlap-skip
# still runs (correctness). Use as a diagnostic to see what whisper actually
# emits before our heuristics touch it.
# MEEPCALL_WHISPER_NO_FILTERS=1
#
# Whisper's no-speech threshold. Default 0.6 is tuned for spoken speech.
# Lower (0.3-0.4) for music — singing has different acoustic features and
# whisper often classifies sung audio as silence. Higher (0.7-0.8) suppresses
# hallucinations on quiet/noisy audio.
# MEEPCALL_NO_SPEECH_THOLD=0.4
